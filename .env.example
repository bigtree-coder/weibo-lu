# ============================================
# 微博爬虫配置文件
# 复制此文件为 .env 并填入你的配置
# cp .env.example .env
# ============================================

# 微博 Cookie（必填）
# 获取方法：
# 1. 用 Chrome 打开 https://m.weibo.cn 并登录
# 2. 按 F12 打开开发者工具
# 3. 切换到 Network（网络）标签
# 4. 刷新页面
# 5. 点击任意一个请求，在 Request Headers 中找到 Cookie
# 6. 复制完整的 Cookie 值粘贴到下面
WEIBO_COOKIE=你的Cookie值

# 微博关注分组 ID（必填）
# 获取方法：
# 1. 在 Chrome 中打开 https://m.weibo.cn/feed/friends
# 2. 点击顶部你想要爬取的分组
# 3. 查看地址栏 URL 中的 gid 参数，例如：
#    https://m.weibo.cn/feed/friends?gid=123456789
#    则分组 ID 为 123456789
WEIBO_GROUP_ID=你的分组ID

# 爬取间隔（秒），默认 3600（1小时）
SCRAPE_INTERVAL=3600

# Flask 端口，默认 5000
PORT=5000
